{
  "name": "LMS",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "LMS/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/LMS",
        "index": "LMS/src/index.html",
        "main": "LMS/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "LMS/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "LMS/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "shared/src/assets",
            "output": "assets"
          },
          {
            "input": "LMS/src",
            "glob": "favicon.ico",
            "output": "."
          },
          {
            "input": "LMS/src",
            "glob": "index.html",
            "output": "."
          },
          {
            "input": "LMS/src",
            "glob": "web.config",
            "output": "."
          }
        ],

        "styles": [
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "node_modules/primeng/resources/themes/lara-light-blue/theme.css",
          "node_modules/primeng/resources/primeng.min.css",
          "node_modules/primeicons/primeicons.css",
          "LMS/src/styles.scss"
        ],
        "scripts": ["node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "10MB",
              "maximumError": "50MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "1MB",
              "maximumError": "10MB"
            }
          ],
          "outputHashing": "all",
          "optimization": true,
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false,
          "buildOptimizer": true
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "10MB",
              "maximumError": "50MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "1MB",
              "maximumError": "10MB"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "LMS:build:production"
        },
        "development": {
          "buildTarget": "LMS:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "LMS:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "LMS/jest.config.ts"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "LMS:build",
        "spa": true
      }
    }
  }
}
